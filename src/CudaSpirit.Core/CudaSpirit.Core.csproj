<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CudaSpirit.Core</RootNamespace>
    <Version>2.4.3</Version>
    <AssemblyVersion>2.4.3.0</AssemblyVersion>
    <FileVersion>2.4.3.0</FileVersion>
    <!-- Embed symbols so publish doesn't drop a loose CudaSpirit.Core.pdb next to the exe. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\data\bdo-grind-catalog.json" Link="Data\bdo-grind-catalog.json" />
  </ItemGroup>

</Project>
